# Copia questo file in backend/.env e cambia i valori. Non committare mai il file .env.
APP_ENV=development
# In produzione: una stringa casuale lunga (es. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
APP_SECRET_KEY=replace_me
# Sviluppo veloce senza installare nulla: sqlite:///./sonora_dev.db
# Con Docker (docker compose up -d db):  postgresql+psycopg://sonora:sonora@localhost:5432/sonora
DATABASE_URL=sqlite:///./sonora_dev.db
FRONTEND_ORIGIN=http://localhost:5173
# Catalogo (Milestone 2–3)
STORE_COUNTRY=it            # storefront Apple: anteprime e link per questo paese
CHART_COUNTRIES=it,us,gb,es,fr,de  # classifiche usate per i brani popolari (quella di STORE_COUNTRY pesa di più)
ITUNES_ENABLED=true         # iTunes Search API: nessuna chiave, solo uso promozionale (docs/PROVIDERS.md)
LIVE_SEARCH=true            # la ricerca chiede ad Apple i brani che mancano nel catalogo
MUSICBRAINZ_CONTACT=        # tua email: attiva l'arricchimento ISRC da MusicBrainz (facoltativo)
DEMO_MODE=false             # true = mostra anche i 60 brani [DEMO] fittizi (python -m app.jobs.seed_demo)

# Produzione (impostate da render.yaml, vedi docs/DEPLOY.md)
TRUST_PROXY=false
INGEST_TOKEN=
INGEST_ON_START=false

# Redis servirà dalla milestone 3 (rate limit condiviso, cache feed). Non ancora usato.
REDIS_URL=redis://localhost:6379/0

# Credenziali provider: aggiungerle solo dopo aver verificato idoneità e termini (docs/LEGAL_AND_PROVIDER_RULES.md).
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
